{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**/*" }]
    },
    "fs:allow-fstat",
    "fs:allow-read"
  ]
}
